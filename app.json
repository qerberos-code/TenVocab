{
  "expo": {
    "name": "Ten Vocab",
    "slug": "wordwise",
    "version": "1.2",
    "orientation": "portrait",
    "scheme": "tenwords",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Ten Vocab uses the camera to read word lists you point it at. Images are processed on this device and never leave it."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ten Vocab reads word lists from photos you choose. Photos are processed on this device and never leave it.",
          "cameraPermission": "Ten Vocab uses the camera to read word lists you point it at. Images are processed on this device and never leave it."
        }
      ],
      "./plugins/withPodDeploymentTarget.js"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qerberos.wordwise",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.qerberos.wordwise",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F7F4"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F7F4"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "04cd5926-dea2-4fca-8fda-d00f5d132c97"
      }
    },
    "owner": "chentail"
  }
}
