{
  "expo": {
    "name": "VocabSAT",
    "slug": "vocabsat",
    "version": "0.2.4",
    "orientation": "portrait",
    "scheme": "vocabsat",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qerberos.vocabsat",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.qerberos.vocabsat",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F7F4"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F7F4"
    }
  }
}
